# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM access (your agent) ---------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model with tool calling. openai/gpt-4o-mini can return 404 when tools are passed; gpt-4.1-mini works.
MODEL=openai/gpt-4.1-mini
# Embeddings for your knowledge-base retrieval (1536 dimensions)
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Simulated helpdesk API (services/helpdesk_api.py) ---------------------
# The API, the MCP server and your app must use the SAME key.
HELPDESK_API_KEY=dev-key-change-me
HELPDESK_API_URL=http://localhost:8102
# Fixes "today" (YYYY-MM-DD) for ticket timestamps and the status page. Empty = real today.
HELPDESK_TODAY=
# MCP server: seconds before a call to the API gives up, and its log level (WARNING keeps stderr quiet)
HELPDESK_TIMEOUT_S=20
HELPDESK_MCP_LOG_LEVEL=WARNING

# --- Local metadata for tickets created through the approval flow ----------
# Defaults to services/data/helpdesk_metadata.sqlite3 within this project.
HELPDESK_METADATA_DB_PATH=

# --- Simulated helpdesk API: permanent ticket database ----------------------
# Defaults to services/data/helpdesk_tickets.sqlite3. Must differ from the metadata DB.
HELPDESK_TICKET_DB_PATH=
# Tests only: "1" lets /admin/reset wipe an explicitly configured HELPDESK_TICKET_DB_PATH.
HELPDESK_ALLOW_DESTRUCTIVE_RESET=

# --- Read-only ticket intelligence API (app.py) ------------------------------
# Leave empty to keep /api/intelligence/* disabled (404). Set it in your own .env only; never commit a value.
HELPDESK_INTELLIGENCE_TOKEN=

# --- Your app and the eval runner ------------------------------------------
# Your API contract (FastAPI). The UI starter and evals/run_evals.py call it.
APP_URL=http://localhost:8000
# Optional: model for run_evals.py --judge
JUDGE_MODEL=openai/gpt-4.1-mini
