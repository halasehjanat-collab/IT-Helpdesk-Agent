      "tags": "Lower-case keywords.",
      "error_codes": "Error codes the document explains (may be empty)."
    },
    "ticket": {
      "ticket_id": "IT-1001..IT-1040 in the archive; the API issues IT-2001, IT-2002, ... for new tickets.",
      "subject": "One line.",
      "description": "Symptom and context in the employee's words (untrusted text).",
      "category": "network_access | identity_access | hardware | software | email_collab | security | onboarding | other.",
      "priority": "P1 | P2 | P3 | P4 (definitions in KB-015).",
      "status": "open | resolved | closed (closed = rejected, duplicate or no action needed).",
      "requester_email": "Employee email in the directory.",
      "department": "Requester's department (Engineering, Finance, HR, Sales, Support, Executive Office, Contractors).",
      "affected_users": "How many people had the problem.",
      "assigned_team": "Derived from the category (KB-015 section 3).",
      "attempted_steps": "Steps tried before the ticket (at least one).",
      "kb_refs": "KB/SP ids used. May be empty.",
      "resolution": "What fixed it, or null while open.",
      "created_at / resolved_at": "UTC timestamps, resolved_at null while open.",
      "notes": "List of {at, author, text}."
