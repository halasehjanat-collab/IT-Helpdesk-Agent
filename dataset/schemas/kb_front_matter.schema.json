{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://help.nakhla.example/schemas/kb_front_matter.schema.json",
  "title": "Knowledge-base document metadata (front matter)",
  "description": "Nakhla Systems (fictional). Markdown files start with this YAML block between '---' lines. PDF files repeat it in the DOCUMENT CONTROL box on page 1. YAML loaders read last_updated as a date: convert it to an ISO string before validating.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "last_updated", "status", "authoritative", "owner", "supersedes", "applies_to", "tags", "error_codes"],
  "properties": {
    "id": {"type": "string", "pattern": "^(KB|SP)-\\d{3}$", "description": "KB-xxx for articles, SP-xxx for security policies."},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+$", "description": "major.minor, compared per document."},
    "last_updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "status": {"enum": ["current", "deprecated", "draft"], "description": "Only current documents are sources for instructions."},
    "authoritative": {"type": "boolean", "description": "true = the owning team's official answer on this topic."},
    "owner": {"type": "string", "minLength": 2},
    "supersedes": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(KB|SP)-\\d{3}$"}], "description": "The older document this one replaces."},
    "applies_to": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["all", "Engineering", "Finance", "HR", "Sales", "Support", "Executive Office", "Contractors"]},
      "description": "[all] or a list of departments."
    },
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2,4}-\\d{2,4}$"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["deprecated", "draft"]}}}, "then": {"properties": {"authoritative": {"const": false}}}},
    {"if": {"properties": {"applies_to": {"contains": {"const": "all"}}}}, "then": {"properties": {"applies_to": {"maxItems": 1}}}}
  ]
}
